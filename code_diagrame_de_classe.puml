=====================================================================
 CODES UML DES DIAGRAMMES DE CLASSES - Agence de voyage (Cotonou)
=====================================================================
 PlantUML : coller sur https://www.plantuml.com/plantuml
 Mermaid  : coller sur https://mermaid.live (ou dans un README GitHub)


=====================================================================
 DIAGRAMME 1 : VERSION SIMPLIFIEE (celle du document)
=====================================================================

---------------------------------------------------------------------
 1.1) PlantUML
---------------------------------------------------------------------

@startuml
skinparam classAttributeIconSize 0

class Passager {
    - idPassager : int
    - nom : String
    - prenom : String
    - numeroPasseport : String
    - telephone : String
    - email : String
    + creerPassager()
    + afficherInfos()
}

class Avion {
    - idAvion : int
    - modele : String
    - capaciteTotale : int
    + verifierDisponibilite()
}

class Vol {
    - idVol : int
    - numeroVol : String
    - villeDepart : String
    - villeArrivee : String
    - dateDepart : DateTime
    - prixBase : double
    - placesDisponibles : int
    - statut : StatutVol
    + creerVol()
    + calculerPlacesRestantes()
    + estComplet() : boolean
}

class Reservation {
    - idReservation : int
    - dateReservation : Date
    - classe : ClasseVol
    - nombrePlaces : int
    - prixTotal : double
    - statut : StatutReservation
    + calculerPrixTotal()
    + confirmerReservation()
    + annulerReservation()
}

class Billet {
    - idBillet : int
    - numeroBillet : String
    - dateEmission : Date
    + genererBillet()
    + imprimerBillet()
}

class Paiement {
    - idPaiement : int
    - montant : double
    - modePaiement : ModePaiement
    - statut : StatutPaiement
    + effectuerPaiement()
    + rembourser()
}

class Annulation {
    - idAnnulation : int
    - dateAnnulation : Date
    - motif : String
    - montantRembourse : double
    + calculerRemboursement()
}

Passager "1" -- "*" Reservation : effectue >
Vol "1" -- "*" Reservation : concerne >
Avion "1" -- "*" Vol : assure >
Reservation "1" -- "1..*" Billet : génère >
Reservation "1" -- "1" Paiement : est payée par >
Reservation "1" -- "0..1" Annulation : subit >

@enduml


