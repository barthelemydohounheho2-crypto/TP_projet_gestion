=====================================================================
 DIAGRAMME 2 : VERSION COMPLETE (alignee sur le code C++)
=====================================================================

---------------------------------------------------------------------
 2.1) PlantUML
---------------------------------------------------------------------

@startuml
skinparam classAttributeIconSize 0
skinparam linetype ortho

enum StatutVol { PREVU  ANNULE  TERMINE }
enum ClasseVol { ECONOMIQUE  AFFAIRES }
enum StatutReservation { CONFIRMEE  EN_ATTENTE  ANNULEE }
enum StatutBillet { VALIDE  UTILISE  ANNULE }
enum ModePaiement { MTN_MOMO  MOOV_MONEY  ESPECES  CARTE }
enum StatutPaiement { PAYE  EN_ATTENTE  ECHOUE  REMBOURSE }

class Passager {
    - idPassager : int
    - nom : String
    - prenom : String
    - dateNaissance : Date
    - numeroPasseport : String {unique}
    - telephone : String
    - email : String
    - nationalite : String
    + creerPassager()
    + modifierPassager()
    + afficherInfos()
    + {static} rechercherParPasseport() : Passager
}

class Avion {
    - idAvion : int
    - modele : String
    - capaciteTotale : int
    - compagnie : String
    + creerAvion()
    + verifierDisponibilite() : boolean
    + afficherAvion()
}

class Vol {
    - idVol : int
    - numeroVol : String
    - villeDepart : String
    - villeArrivee : String
    - dateDepart : DateTime
    - dateArrivee : DateTime
    - prixBase : double
    - placesDisponibles : int
    - statut : StatutVol
    + creerVol()
    + modifierVol()
    + annulerVol()
    + calculerPlacesRestantes() : int
    + estComplet() : boolean
    + afficherVol()
}

class Reservation {
    - idReservation : int
    - dateReservation : Date
    - classe : ClasseVol
    - nombrePlaces : int
    - sieges : int[1..*]
    - prixTotal : double
    - statut : StatutReservation
    + creerReservation()
    + calculerPrixTotal()
    + confirmerReservation()
    + annulerReservation()
    + afficherReservation()
}

class Billet {
    - idBillet : int
    - numeroBillet : String {unique}
    - siege : int
    - dateEmission : Date
    - statut : StatutBillet
    + genererBillet()
    + imprimerBillet()
    + validerBillet()
}

class Paiement {
    - idPaiement : int
    - montant : double
    - datePaiement : Date
    - modePaiement : ModePaiement
    - statut : StatutPaiement
    + effectuerPaiement()
    + verifierPaiement() : boolean
    + rembourser()
    + genererRecu()
}

class Annulation {
    - idAnnulation : int
    - dateAnnulation : Date
    - motif : String
    - montantRembourse : double
    - fraisAnnulation : double
    + {static} TAUX_FRAIS : double = 0.20
    + calculerRemboursement()
    + enregistrerAnnulation()
    + afficherAnnulation()
}

Passager "1" -- "*" Reservation : effectue >
Vol "1" -- "*" Reservation : concerne >
Avion "1" -- "*" Vol : assure >
Reservation "1" -- "1..*" Billet : génère >
Reservation "1" -- "0..1" Paiement : est payée par >
Reservation "1" -- "0..1" Annulation : subit >
Paiement "1" -- "0..1" Annulation : est remboursé par >

Vol ..> StatutVol
Reservation ..> ClasseVol
Reservation ..> StatutReservation
Billet ..> StatutBillet
Paiement ..> ModePaiement
Paiement ..> StatutPaiement

@enduml


